# Rust
/target/
**/*.rs.bk

# Cargo.lock IS committed. This is a binary, not a library, and libcosmic is an
# unpublished git dependency pinned by revision — without the lockfile a
# contributor resolves a different tree of transitive crates than CI does.

# Local project scaffolding (PARA working folders — not part of the public crate)
/working/
/context/
/archive/
/sources/
/planning/
/.claude/

# Editor / OS
.direnv/
*.swp
.DS_Store

# Local working notes — not for the public repo
/CLAUDE.md

# updpkgsums downloads the release tarball next to the PKGBUILD.
packaging/*.tar.gz
