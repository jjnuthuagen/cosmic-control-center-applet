[Desktop Entry]
Name=Control Center
Comment=Wi-Fi, Bluetooth, power profiles, DNS, volume and brightness
Exec=cosmic-control-center-applet
Icon=io.github.jjnuthuagen.ControlCenter
Terminal=false
Type=Application
# Applets are launched by cosmic-panel, not from the app grid.
NoDisplay=true
Categories=COSMIC;
Keywords=COSMIC;Applet;Settings;Network;Bluetooth;Battery;DNS;Volume;Brightness;
X-CosmicApplet=true
X-NotShowIn=GNOME;KDE;
